<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Bootstrap theme used only while the activity launches. Compose
      MaterialTheme (see core:designsystem) takes over once setContent runs,
      so this stays intentionally minimal. Parented on Theme.SplashScreen so
      installSplashScreen() can render the system splash on API 31+.
    -->
    <style name="Theme.LifeOS.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.LifeOS</item>
    </style>

    <!-- Theme handed off to once setContent runs. Compose owns the look. -->
    <style name="Theme.LifeOS" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
